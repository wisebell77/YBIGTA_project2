      <aliases enabled='yes' />
      <column caption='Commodity Desc' datatype='string' name='[COMMODITY_DESC]' role='dimension' type='nominal' />
      <column caption='visit_ci_low' datatype='real' name='[Calculation_0322740926607360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[visit_diff] - 1.96 * [visit_se]' />
      </column>
      <column caption='visit_ci_up' datatype='real' name='[Calculation_0322740926648321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[visit_diff] + 1.96 * [visit_se]' />
      </column>
      <column caption='spend_ci_low' datatype='real' name='[Calculation_0322740927361026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='spend_diff - 1.96 * spend_se' />
      </column>
      <column caption='spend_ci_up' datatype='real' name='[Calculation_0322740927414275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='spend_diff + 1.96 * spend_se' />
      </column>
      <column caption='분석 카테고리 수 ' datatype='integer' name='[Calculation_0322740939071492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([COMMODITY_DESC])' />
      </column>
      <column caption='관계 강화 카테고리 수' datatype='integer' name='[Calculation_0322740940562437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF LEFT([performance_quadrant], 2) = &quot;Q1&quot;&#10;    THEN [COMMODITY_DESC]&#10;    END&#10;)' />
      </column>
      <column caption='관계 악화 카테고리 수' datatype='integer' name='[Calculation_0322740949487622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF LEFT([performance_quadrant], 2) = &quot;Q4&quot;&#10;    THEN [COMMODITY_DESC]&#10;    END&#10;)' />
      </column>
      <column caption='관계 강화 후보 비율' datatype='real' name='[Calculation_0322740949716999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF LEFT([performance_quadrant], 2) = &quot;Q1&quot;&#10;    THEN [COMMODITY_DESC]&#10;    END&#10;)&#10;/&#10;COUNTD([COMMODITY_DESC])' />
      </column>
      <column caption='우선순위' datatype='real' name='[Calculation_0322740953284618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[spend_diff]/[spend_se]' />
      </column>
      <column caption='지출효과 Z점수' datatype='real' name='[Calculation_0322740957478923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [spend_se] &gt; 0 THEN&#10;    [spend_diff] / [spend_se]&#10;END' />
      </column>
      <column caption='조치 수준' datatype='string' name='[Calculation_0322740972843020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [households] &gt;= 100&#10;AND [Calculation_0322740957478923] &lt;= -1.96&#10;THEN &quot;중단 우선 검토&quot;&#10;&#10;ELSEIF [households] &gt;= 30&#10;THEN &quot;타깃·할인조건 재설계&quot;&#10;&#10;ELSE&#10;    &quot;추가 관찰&quot;&#10;END' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_0322741015425037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='index1' datatype='integer' name='[Calculation_0322741016412176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='지출감소순위' datatype='integer' name='[Calculation_0322741016879123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(AVG([spend_diff]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
