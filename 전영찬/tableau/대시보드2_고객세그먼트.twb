      <column caption='세그먼트 ID' datatype='string' name='[Calculation_0447604372422656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[value_tier]&#10;+ &quot; | &quot;&#10;+ STR([churn_risk])&#10;+ &quot; | &quot;&#10;+ [cat_behavior]' />
      </column>
      <column caption='분석 세그먼트 수' datatype='integer' name='[Calculation_0447604372480001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_0447604372422656])' />
      </column>
      <column caption='가구 관측 합계' datatype='integer' name='[Calculation_0447604373336066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([households])' />
      </column>
      <column caption='관계 강화 세그먼트 ' datatype='integer' name='[Calculation_0447604374036483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF LEFT([performance_quadrant], 2) = &quot;Q1&quot;&#10;    THEN [Calculation_0447604372422656]&#10;    END&#10;)' />
      </column>
      <column caption='관계 약화 세그먼트 수' datatype='integer' name='[Calculation_0447604374294532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF LEFT([performance_quadrant], 2) = &quot;Q4&quot;&#10;    THEN [Calculation_0447604372422656]&#10;    END&#10;)' />
      </column>
      <column caption='가구 가중 지출 차이' datatype='real' name='[Calculation_0447604375261189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([spend_diff] * [households])&#10;/&#10;SUM([households])' />
      </column>
      <column caption='가구 가중 방문 차이' datatype='real' name='[Calculation_0447604375293958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([visit_diff] * [households])&#10;/&#10;SUM([households])' />
      </column>
      <column caption='추천 전략' datatype='string' name='[Calculation_0447604378525703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LEFT([performance_quadrant], 2)&#10;WHEN &quot;Q1&quot; THEN &quot;유지·확대&quot;&#10;WHEN &quot;Q2&quot; THEN &quot;할인 깊이·구매조건 조정&quot;&#10;WHEN &quot;Q3&quot; THEN &quot;대용량·방문통합 여부 검토&quot;&#10;WHEN &quot;Q4&quot; THEN &quot;중단 또는 타깃 재설계&quot;&#10;END' />
      </column>
